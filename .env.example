# Để trống: frontend gọi API/Socket.IO qua proxy cùng cổng (học sinh ở máy khác vẫn kết nối được).
# Chỉ đặt khi backend chạy ở địa chỉ riêng, ví dụ:
# VITE_API_BASE_URL=https://api.truonghoc.vn/api/v1
# VITE_SOCKET_URL=https://api.truonghoc.vn

# Đăng nhập Google qua Firebase (Firebase Console → Project settings → Your apps → Web app).
# Để trống thì ẩn nút "Tiếp tục với Google". Backend cần đặt FIREBASE_PROJECT_ID trùng project này.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
