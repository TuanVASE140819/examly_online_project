NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/examly?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-before-running"
FRONTEND_ORIGIN="http://localhost:5173"
# Số lớp proxy phía trước để đọc IP thật của học sinh (mặc định "loopback" = proxy của Vite trên cùng máy; Render: 1)
TRUST_PROXY=loopback
# Đặt khi muốn backend phục vụ luôn frontend đã build (triển khai một dịch vụ, ví dụ Render)
# FRONTEND_DIST=../dist
