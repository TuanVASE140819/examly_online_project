generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEACHER
  STUDENT
  ADMIN
}

enum ExamStatus {
  DRAFT
  WAITING
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  SUBMITTED
  ABSENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY
}

enum SubmitReason {
  MANUAL
  TIMEOUT
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  // null: tài khoản tạo bằng đăng nhập Google, không có mật khẩu
  passwordHash String?
  displayName  String
  role         UserRole      @default(STUDENT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownedExams   Exam[]        @relation("ExamOwner")
  approved     Participant[] @relation("ApprovedBy")
  teachingClasses       Classroom[]            @relation("ClassTeacher")
  classMemberships      ClassMember[]
  assignmentSubmissions AssignmentSubmission[]

  @@map("users")
}

model Exam {
  id              String            @id @default(uuid()) @db.Uuid
  ownerId         String            @db.Uuid
  owner           User              @relation("ExamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  joinCode        String            @default("")
  joinCodeHash    String            @unique
  status          ExamStatus        @default(WAITING)
  durationSeconds Int
  startsAt        DateTime?
  endsAt          DateTime?
  // false: chỉ nhận học sinh cùng mạng với giáo viên (IP giáo viên ghi nhận lúc khóa mạng)
  allowExternalNetwork Boolean      @default(true)
  teacherNetworkIp     String?
  // Học sinh chỉ xem được điểm bài thi sau khi giáo viên công bố
  resultsPublished     Boolean      @default(false)
  resultsPublishedAt   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  questions       Question[]
  participants    Participant[]
  submissions     Submission[]
  events          ProctoringEvent[]
  auditLogs       AuditLog[]

  @@index([ownerId, status])
  @@map("exams")
}

model Question {
  id        String   @id @default(uuid()) @db.Uuid
  examId    String   @db.Uuid
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  type      QuestionType @default(MULTIPLE_CHOICE)
  topic     String   @default("Tổng quát")
  prompt    String
  position  Int
  points    Float    @default(1.0)
  createdAt DateTime @default(now())
  options   Option[]
  answers   Answer[]

  @@unique([examId, position])
  @@index([examId])
  @@map("questions")
}

model Option {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  position   Int
  answers    Answer[]

  @@unique([questionId, position])
  @@map("options")
}

model Participant {
  id           String            @id @default(uuid()) @db.Uuid
  examId       String            @db.Uuid
  exam         Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId       String?           @db.Uuid
  displayName  String
  className    String
  status       ParticipantStatus @default(PENDING)
  approvedById String?           @db.Uuid
  approvedBy   User?             @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  joinedAt     DateTime          @default(now())
  answers      Answer[]
  submission   Submission?
  events       ProctoringEvent[]

  @@unique([examId, userId])
  @@index([examId, status])
  @@index([examId, joinedAt])
  @@map("participants")
}

model Answer {
  id               String      @id @default(uuid()) @db.Uuid
  participantId    String      @db.Uuid
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  questionId       String      @db.Uuid
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?     @db.Uuid
  selectedOption   Option?     @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  // Câu tự luận: bài làm của học sinh và điểm giáo viên chấm (null = chưa chấm)
  textAnswer       String?
  awardedPoints    Float?
  savedAt          DateTime    @updatedAt

  @@unique([participantId, questionId])
  @@map("answers")
}

model Submission {
  id             String       @id @default(uuid()) @db.Uuid
  participantId  String       @unique @db.Uuid
  participant    Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  examId         String       @db.Uuid
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  startedAt      DateTime     @default(now())
  submittedAt    DateTime     @default(now())
  reason         SubmitReason @default(MANUAL)
  score          Float?
  maxScore       Float        @default(10.0)
  correctCount   Int          @default(0)
  // Số câu trắc nghiệm của đề (câu tự luận không tính đúng/sai)
  totalQuestions Int          @default(0)
  // Số câu tự luận đã làm nhưng giáo viên chưa chấm; score = null cho tới khi về 0
  pendingEssays  Int          @default(0)
  gradedAt       DateTime?

  @@index([examId, submittedAt])
  @@map("submissions")
}

model ProctoringEvent {
  id            String       @id @default(uuid()) @db.Uuid
  examId        String       @db.Uuid
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  participantId String?      @db.Uuid
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  eventType     String
  occurredAt    DateTime     @default(now())
  metadata      Json?

  @@index([examId, occurredAt])
  @@index([participantId])
  @@map("proctoring_events")
}

// Lớp học do giáo viên quản lý; học sinh vào lớp bằng mã lớp hoặc được giáo viên thêm theo email
model Classroom {
  id          String        @id @default(uuid()) @db.Uuid
  teacherId   String        @db.Uuid
  teacher     User          @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  name        String
  description String?
  joinCode    String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     ClassMember[]
  assignments Assignment[]

  @@index([teacherId])
  @@map("classrooms")
}

model ClassMember {
  id        String    @id @default(uuid()) @db.Uuid
  classId   String    @db.Uuid
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String    @db.Uuid
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())

  @@unique([classId, studentId])
  @@index([studentId])
  @@map("class_members")
}

// Bài tập về nhà giao cho cả lớp; điểm chỉ hiện với học sinh khi giáo viên công bố
model Assignment {
  id              String                 @id @default(uuid()) @db.Uuid
  classId         String                 @db.Uuid
  classroom       Classroom              @relation(fields: [classId], references: [id], onDelete: Cascade)
  title           String
  instructions    String
  dueAt           DateTime?
  maxScore        Float                  @default(10)
  gradesPublished Boolean                @default(false)
  publishedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  submissions     AssignmentSubmission[]

  @@index([classId, createdAt])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String     @db.Uuid
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String
  submittedAt  DateTime   @default(now())
  // null = chưa chấm; sau khi chấm học sinh không sửa bài được nữa
  score        Float?
  feedback     String?
  gradedAt     DateTime?

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  examId    String?  @db.Uuid
  exam      Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([examId, createdAt])
  @@map("audit_logs")
}
